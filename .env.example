# Copy this file to ".env" (same folder as docker-compose.yml) to override the defaults.
# "docker compose up" works without it: every value below is also the default.
# The .env file is ignored by git, so real secrets never get committed.
# Use only letters, digits, "-" and "_" in passwords (they are placed inside connection URLs).

# RabbitMQ login (management UI: http://localhost:15672)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# One PostgreSQL password per service: the databases are separate on purpose
ORDER_DB_PASSWORD=order
INVENTORY_DB_PASSWORD=inventory

# pino log level for both services: trace | debug | info | warn | error | silent
LOG_LEVEL=info
