# Only needed when you run the service OUTSIDE Docker (cd order-service && npm start).
# With "docker compose up" these values are set by docker-compose.yml.
# Start PostgreSQL and RabbitMQ first, for example: docker compose up -d postgres-order rabbitmq
# (the compose file does not publish the database port, so add a "ports" entry or run your own Postgres).

PORT=3000
DATABASE_URL=postgres://order:order@localhost:5432/orders
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=info

# Optional message-handling settings
# MAX_DELIVERY_ATTEMPTS=3   # a failing message is retried this many times, then dead-lettered
# RETRY_DELAY_MS=1000       # wait between retries (multiplied by the attempt number)
